PORT=3000
JWT_SECRET=super-secret-key-change-in-production
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=super-secret-refresh-key-change-in-production
JWT_REFRESH_EXPIRATION=7d
LOG_LEVEL=info

# Database Configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/futurepath_db?schema=public"

# Feature Flags
ENABLE_REDIS=false
ENABLE_BULLMQ=false

# Redis Configuration (Used only if enabled)
REDIS_HOST=localhost
REDIS_PORT=6379
