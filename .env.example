# ── FuturePath AI backend — environment template ────────────────────────────
# Copy to .env for local dev and fill real values. In production (Render/Railway)
# set these in the platform dashboard — never commit a real .env.

# App
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# ── Auth ── use long random strings in production (openssl rand -hex 32)
JWT_SECRET=super-secret-key-change-in-production
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=super-secret-refresh-key-change-in-production
JWT_REFRESH_EXPIRATION=7d

# ── CORS ── comma-separated list of allowed frontend origins.
# Leave empty for local dev (allows all). In production set to your frontend URL:
#   CORS_ORIGINS=https://futurepath-ai.pages.dev,https://yourdomain.com
CORS_ORIGINS=

# ── Database ── MySQL / MariaDB. Local XAMPP default shown below.
DATABASE_URL="mysql://root:@127.0.0.1:3306/futurepath"
# Set to true for cloud MySQL that requires TLS (TiDB Cloud, Aiven, PlanetScale).
DATABASE_SSL=false
# Only set to true if the provider uses a self-signed cert (skips verification).
DATABASE_SSL_INSECURE=false

# ── AI provider ── OpenCodeZen is the active provider.
OPENCODEZEN_API_KEY=

# ── Optional infra ── off by default; app falls back to in-memory cache.
ENABLE_REDIS=false
ENABLE_BULLMQ=false
REDIS_HOST=localhost
REDIS_PORT=6379
