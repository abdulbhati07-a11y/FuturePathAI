# ── FuturePath AI — environment template ──────────────────────────────────────
# Copy to .env for local dev and fill in real values. In production, set these in
# the Vercel dashboard (Project → Settings → Environment Variables) — the whole
# backend is a single serverless function at frontend/api/index.ts. Never commit
# a real .env.

# ── Auth ── use a long random string in production (openssl rand -hex 32).
# The API signs 15-minute access tokens with this secret.
JWT_SECRET=super-secret-key-change-in-production

# ── Database ── Supabase Postgres.
# ⚠️ SERVERLESS (Vercel) MUST use the Supabase connection POOLER, not the direct
# connection. The direct host (db.<ref>.supabase.co:5432) is IPv6-only and is
# UNREACHABLE from Vercel — every query hangs/fails. Use Supavisor instead:
#   • DATABASE_URL → Transaction pooler, port 6543 (serverless runtime)
#   • DIRECT_URL   → Session pooler,    port 5432 (prisma migrate only)
# Copy the exact strings from Supabase → Connect → "Connection pooling", and
# replace <AWS-REGION> with your project's region (e.g. eu-central-1).
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-<AWS-REGION>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-<AWS-REGION>.pooler.supabase.com:5432/postgres"

# ── AI provider ── Groq (llama-3.1-8b-instant) is the PRIMARY chat + report engine.
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# ── AI backup (optional) ── If Groq is rate-limited/down and this is set, the API
# transparently fails over to Google Gemini (gemini-flash-latest) via its
# OpenAI-compatible endpoint. Free key, no card: https://aistudio.google.com/apikey
GEMINI_API_KEY=
