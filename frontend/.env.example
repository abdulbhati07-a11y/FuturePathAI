# ── Frontend environment variables (Vite) ────────────────────────────────────
# Copy to `.env` for local dev. Vite reads env files from this `frontend/` folder
# and inlines VITE_* vars into the build. In production these are set in the
# Vercel dashboard (Project → Settings → Environment Variables), NOT committed.

# Base URL for the API. The backend is a same-origin Vercel serverless function
# reached at /api, so leave this EMPTY — the client falls back to same-origin /api.
# Only set it to point at a different host (rarely needed).
VITE_API_BASE_URL=

# Set to "true" to run the UI against in-memory mock data (no backend needed).
VITE_USE_MOCKS=false
