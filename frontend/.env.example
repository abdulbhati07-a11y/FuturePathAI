# ── Frontend environment variables ───────────────────────────────────────────
# Copy to `.env` for local dev. In production these are set in the
# Cloudflare Pages dashboard (Settings → Environment variables), NOT committed.

# Base URL of the deployed NestJS backend (no trailing slash).
# Local dev default is http://localhost:3000
VITE_API_BASE_URL=http://localhost:3000

# Set to "true" to run the UI against in-memory mock data (no backend needed).
VITE_USE_MOCKS=false
